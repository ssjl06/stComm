#!/bin/bash
# stComm Environment Configuration Example
# Copy this file to env.sh and modify paths according to your system

# GCC/G++ Compiler
export GCC_HOME="/usr/local/gcc"
export CC="${GCC_HOME}/bin/gcc"
export CXX="${GCC_HOME}/bin/g++"

# CMake
export CMAKE_HOME="/usr/local/cmake"
export CMAKE="${CMAKE_HOME}/bin/cmake"

# CUDA Toolkit
export CUDA_HOME="/usr/local/cuda"
export CUDA_PATH="${CUDA_HOME}"

# OpenMPI
export MPI_HOME="/usr/local/openmpi"

# NCCL
export NCCL_HOME="/usr/local/nccl"

# Google Test
export GTEST_HOME="/usr/local/gtest"

# Update PATH and LD_LIBRARY_PATH
export PATH="${GCC_HOME}/bin:${CMAKE_HOME}/bin:${CUDA_HOME}/bin:${MPI_HOME}/bin:${PATH}"
export LD_LIBRARY_PATH="${GCC_HOME}/lib64:${CUDA_HOME}/lib64:${MPI_HOME}/lib:${NCCL_HOME}/lib:${GTEST_HOME}/lib:${LD_LIBRARY_PATH}"

# CUDA architecture (adjust for your GPU)
export CUDA_ARCH="75"  # e.g., 75 for Turing, 80 for Ampere, 89 for Ada Lovelace
